# Primary Prisma connection string used by the app.
# For Supabase + Prisma pooler, reuse POSTGRES_PRISMA_URL.
DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Supabase public client config (safe in browser)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# Public app origin used for auth email redirects
NEXT_PUBLIC_APP_URL="https://felix-crm-xi.vercel.app"

# Supabase server-side config
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
SUPABASE_SECRET_KEY="<secret-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_JWT_SECRET="<jwt-secret>"

# Optional explicit Postgres pieces
POSTGRES_DATABASE="postgres"
POSTGRES_HOST="db.<project-ref>.supabase.co"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="<password>"
POSTGRES_URL="postgres://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x"
POSTGRES_URL_NON_POOLING="postgres://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
POSTGRES_PRISMA_URL="postgres://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Shared outbound pacing for Amazon Connect. This smooths team dialing across reps.
FELIXCRM_TEAM_DIAL_SPACING_MS="4000"
FELIXCRM_TEAM_THROTTLE_COOLDOWN_MS="30000"
FELIXCRM_ACCOUNT_MANAGEMENT_VIEWER_EMAILS="felix@felixcrego.com,eliot30523@gmail.com"

# Google Calendar OAuth2 config for Meet link creation
GOOGLE_CLIENT_ID="<google-client-id>"
GOOGLE_CLIENT_SECRET="<google-client-secret>"
GOOGLE_REDIRECT_URI="https://developers.google.com/oauthplayground"
GOOGLE_REFRESH_TOKEN="<google-refresh-token>"

# Optional Gmail send-as settings for CRM outbound email.
# If omitted, Gmail sends from the mailbox tied to GOOGLE_REFRESH_TOKEN.
CRM_FROM_EMAIL="<optional-google-workspace-alias>"
CRM_REPLY_TO_EMAIL="<optional-reply-to-address>"

# Optional explicit template repos used by the CRM deploy selector
VERCEL_TEMPLATE_REPO="<owner/repo>"
VERCEL_TEMPLATE_REPO_NEW_TEMPLATE="<owner/repo>"
VERCEL_TEMPLATE_REPO_MED_SPA="<owner/repo>"

# Marketing Hub sync for closed deals and call-quality feedback
MARKETING_HUB_BASE_URL="https://felix-marketing-hub.vercel.app"
MARKETING_HUB_SYNC_TOKEN="<shared-sync-token>"
MARKETING_HUB_DEFAULT_CLIENT_ID="xpgarage"
MARKETING_HUB_DEFAULT_CUSTOMER_ID=""

# Cron auth for automated weekly client reports.
# Set this to match your Vercel Cron secret and keep it aligned with FELIXCRM_WEBHOOK_SECRET if used.
CRON_SECRET="<cron-secret>"
